/** Monthly report draft only; not official result or B score. */
const NQ52_MONTHLY_DRAFT_VERSION='MONTHLY-DRAFT-2';
function nqSaveMonthlyDraft_(u,p){
 const month=nqMonth_(p.month),input=p.monthlyDraft;if(!input||input.version!==NQ52_MONTHLY_DRAFT_VERSION||!Array.isArray(input.items)||input.items.length>80)nqError_('INVALID_INPUT');
 let r=nqRows_('NQ52_REPORTS').find(x=>String(x.userId)===String(u.id)&&String(x.month)===month);if(r)nqState_(r,['DRAFT']);
 const tasks=nqRows_('NQ52_TASKS').filter(t=>String(t.userId)===String(u.id)&&String(t.month)===month&&t.state!=='CANCELLED'),map=new Map(tasks.map(t=>[String(t.id),t])),seen=new Set();
 function date(v){const s=nqText_(v,10,false);if(!s)return '';if(!/^\d{4}-\d{2}-\d{2}$/.test(s))nqError_('INVALID_DATE');const d=new Date(s+'T00:00:00Z');if(!Number.isFinite(d.getTime())||d.toISOString().slice(0,10)!==s)nqError_('INVALID_DATE');return s;}
 function choice(v,opts){const s=nqText_(v,70,false);if(s&&!opts.includes(s))nqError_('INVALID_INPUT');return s;}
 const items=input.items.map(x=>{if(!x||typeof x!=='object'||Array.isArray(x))nqError_('INVALID_INPUT');const sourceId=nqText_(x.sourceId,100,false);let title,target,deadline,sourceRef,key;if(sourceId){const t=map.get(sourceId);if(!t)nqError_('FORBIDDEN');const d=nqJSON_(t.data);title=String(d.title||'');target=String(d.deliverable||'');deadline=String(d.deadline||'');sourceRef=String(d.source||'');key='S:'+sourceId;}else{title=nqText_(x.title,300,true);target=nqText_(x.target,1000,false);deadline=date(x.deadline);sourceRef=nqText_(x.sourceRef,1000,false);key='M:'+title.toLowerCase().replace(/\s+/g,' ');}if(seen.has(key))nqError_('DUPLICATE_TASK');seen.add(key);const rate=x.completionRate;if(rate!==null&&(typeof rate!=='number'||!Number.isFinite(rate)||rate<0||rate>100))nqError_('INVALID_INPUT');const evidenceUrl=nqText_(x.evidenceUrl,1500,false);if(evidenceUrl&&!/^https?:\/\/[^\s]+$/i.test(evidenceUrl))nqError_('INVALID_INPUT');return {sourceId,sourceType:sourceId?'SYSTEM':'MANUAL',title,target,deadline,sourceRef,nature:choice(x.nature,['Thường xuyên','Đột xuất','Phối hợp','Dài hạn/đánh giá từng phần']),participation:choice(x.participation,['Chủ trì','Phối hợp','Thực hiện độc lập']),completedDate:date(x.completedDate),result:nqText_(x.result,3000,false),taskGroup:choice(x.taskGroup,["I. Theo chương trình, kế hoạch","II. Chuyên môn, thường xuyên theo vị trí việc làm","III. Đột xuất, phát sinh được giao","IV. Hội họp, tập huấn, đào tạo, bồi dưỡng và hoạt động khác"]),complexity:choice(x.complexity,["Bình thường","Phức tạp","Rất phức tạp"]),selfQuality:choice(x.selfQuality,["Chưa bảo đảm chất lượng","Bảo đảm chất lượng","Vượt mức chất lượng"]),incompleteReason:nqText_(x.incompleteReason,1000,false),lateReason:nqText_(x.lateReason,1000,false),recommendation:nqText_(x.recommendation,1000,false),taskStatus:choice(x.taskStatus,['Hoàn thành','Đang thực hiện','Chưa hoàn thành']),completionRate:rate,evidenceUrl,evidenceNote:nqText_(x.evidenceNote,1500,false),note:nqText_(x.note,1000,false)};});
 if(tasks.some(t=>!seen.has('S:'+String(t.id))))nqError_('INVALID_STATE');
 const data=r?nqJSON_(r.data):{};data.monthlyDraft={version:NQ52_MONTHLY_DRAFT_VERSION,items,highlight:nqText_(input.highlight,5000,false),difficulty:nqText_(input.difficulty,5000,false),proposal:nqText_(input.proposal,5000,false),confirmTruth:input.confirmTruth===true,official:false,updatedAt:nqNow_()};
 if(JSON.stringify(data).length>45000)nqError_('REPORT_TOO_LARGE');if(!r){r=nqNewRecord_(month,u,data,'DRAFT');nqWrite_('NQ52_REPORTS',r);}else nqUpdateRecord_('NQ52_REPORTS',r,data,'DRAFT');nqAudit_(u.id,'MONTHLY_REPORT_DRAFT',r.id,{items:items.length});return nqPublicRecord_(r);
}
